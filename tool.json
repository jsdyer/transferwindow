{
  "id": "transferwindow",
  "title": "Transfer Window",
  "description": "See how many scheduled 555 transfers survive a delay at Carvolth or Lougheed and how much time a missed connection adds.",
  "category": "places",
  "tags": [
    "TransLink",
    "Langley",
    "Carvolth",
    "Lougheed",
    "555",
    "GTFS"
  ],
  "icon": "route",
  "url": "/transferwindow/",
  "source": "https://github.com/jsdyer/transferwindow",
  "hosting": "project",
  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "TransLink’s static GTFS timetable supplies scheduled 555 arrivals, onward departures, bays and service-date exceptions.",
    "cadence": "Daily",
    "probes": [
      {
        "label": "Data retrieved",
        "url": "https://coolcode.ca/transferwindow/data/status.json",
        "path": [
          "retrieved"
        ],
        "count_at": {
          "path": [
            "routes"
          ],
          "unit": "transit routes"
        }
      },
      {
        "label": "Coverage",
        "url": "https://coolcode.ca/transferwindow/data/status.json",
        "path": [
          "start"
        ],
        "end_path": [
          "end"
        ]
      }
    ]
  }
}
